# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Local development on hardhat node only needs the WalletConnect id, and even that
# is optional if you connect with MetaMask.

# WalletConnect Cloud project id. Needed for the QR / mobile wallet option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supabase. URL and anon key are safe in the browser, service role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy embedded wallet (checkpoint 3)
NEXT_PUBLIC_PRIVY_APP_ID=

# Groq, used by the moderation and dispute agents (checkpoint 9 and 10). Server only.
GROQ_API_KEY=

# Pinata, for pinning listing images to IPFS. Server only.
PINATA_JWT=

# EmailJS, for notifying owners about new rental requests (checkpoint 8)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Wallet that signs agent decisions on chain. Server only, never expose to the agent.
AGENT_SIGNER_PRIVATE_KEY=

# Where the agent posts its proposals. Points at this app during development,
# swapped for the Latch proxy URL at checkpoint 11.
LATCH_PROXY_URL=http://localhost:3000
