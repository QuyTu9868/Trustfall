{
  "name": "trustfall-contracts",
  "version": "0.1.0",
  "description": "Trustfall escrow contracts. Foundry for tests, Hardhat for compile and deploy.",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "forge test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "fund": "hardhat run scripts/fund.js --network localhost",
    "setup:local": "npm run deploy:local && npm run fund",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
