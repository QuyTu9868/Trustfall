# Copy to .env and fill in.

# Your own wallet addresses, comma separated. `npm run fund` sends each of them
# 10 ETH and 10000 test USDC on the local chain, so you never have to paste a
# test private key into MetaMask. A fresh `hardhat node` wipes all balances, so
# run fund again after every restart.
# Add a second address here when you need an owner and a renter side.
DEV_WALLETS=

# Everything below is only needed when deploying to Sepolia (checkpoint 12).
# Local development on hardhat node needs none of it.

# RPC endpoint for Sepolia (Alchemy, Infura, or any public one)
SEPOLIA_RPC_URL=

# Private key of the deployer wallet. Use a throwaway wallet, never a real one.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, used by hardhat verify to publish the source code
ETHERSCAN_API_KEY=
