# Copy to .env and fill in.

# Your own wallet addresses, comma separated. `npm run fund` sends each of them
# 10 ETH and 10000 test USDC on the local chain, so you never have to paste a
# test private key into MetaMask. A fresh `hardhat node` wipes all balances, so
# run fund again after every restart.
# Add a second address here when you need an owner and a renter side.
DEV_WALLETS=

# Where the 1% platform fee goes. Falls back to the last local test account.
TREASURY_ADDRESS=

# Applies dispute verdicts on chain. This is the server's signing wallet, not the
# agent: the agent proposes over HTTP and the server signs.
# Falls back to the second to last local test account.
AGENT_ADDRESS=

# Human fallback resolver, for when the agent pipeline is down and a dispute needs
# judging now. Same three verdicts as the agent and nothing more: it cannot withdraw,
# cannot pay a third address, cannot change any setting. Must be a DIFFERENT key from
# AGENT_ADDRESS, the contract rejects deployment otherwise.
# Falls back to the third to last local test account.
ADMIN_ADDRESS=

# Everything below is only needed when deploying to Sepolia (checkpoint 12).
# Local development on hardhat node needs none of it.

# RPC endpoint for Sepolia (Alchemy, Infura, or any public one)
SEPOLIA_RPC_URL=

# Private key of the deployer wallet. Use a throwaway wallet, never a real one.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, used by hardhat verify to publish the source code
ETHERSCAN_API_KEY=
