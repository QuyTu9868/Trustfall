# dependencies
node_modules/

# next.js
.next/
out/
*.tsbuildinfo

# hardhat
artifacts/
cache/
typechain-types/

# foundry
contracts/out/
contracts/cache_forge/
contracts/broadcast/

# env
# Ignore every env file by default, then allow the templates back in. Listing
# specific names instead lets a file like .env.test slip through with a private
# key in it.
.env*
!.env.example
!.env*.example
!.env.local.example

# test / coverage
coverage/
coverage.json
lcov.info
test-results/
playwright-report/

# misc
files.zip
.DS_Store
*.log

# Pages saved out of a vendor dashboard while working out their UI. Megabytes of somebody
# else's bundle, and a saved page carries whatever was on screen at the time.
Latch.html
Latch_files/
*_files/

# Carries the gateway secret in plaintext so it can be pasted into a browser console.
services/latch/console-snippet.txt

# Playwright leftovers. Screenshots are worth keeping, traces and videos are not.
frontend/e2e/.artifacts/
frontend/playwright-report/

# The wallet-signing script's step-by-step diagnostics: one set per run, only ever read
# minutes after the run that wrote them. Its two outcome shots are kept.
frontend/e2e/shots/wallet-real-p*-round*.png
frontend/e2e/shots/wallet-real-app-after-*.png
frontend/e2e/shots/wallet-real-attempt*.png
frontend/e2e/shots/wallet-real-failure*.png
