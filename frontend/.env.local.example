# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Anything with the NEXT_PUBLIC_ prefix is compiled into the browser bundle and is
# public. Anything without it stays on the server. Do not add the prefix to a secret.

# Privy. The app id is public, the app secret is not: the secret is what lets the server
# verify a login and read the user's wallet, instead of trusting whatever address the
# browser claims to be.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Supabase. URL and anon key are safe in the browser. The service role key bypasses row
# level security and can wipe the database, so it is server only and never logged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Which chain this build talks to. Defaults to the Hardhat node (31337).
# Set to 11155111 for Sepolia at checkpoint 12.
NEXT_PUBLIC_CHAIN_ID=

# Google Gemini, used by the moderation and dispute agents (checkpoint 9 and 10). Server
# only. Get one at aistudio.google.com. The free tier allows far more per minute than the
# provider this replaced, which is what let the arbitrator go back to reading photographs.
GEMINI_API_KEY=

# Starting value for the listing check switch on /dev, which is the usual way to toggle it.
# Set to 1 to have the check off from boot, which suits a seeding script. Only honoured on
# the local Hardhat chain: on any real network the check runs whatever this says.
MODERATION_BYPASS=


# Wallet that signs agent decisions on chain. Server only, never expose to the agent.
AGENT_SIGNER_PRIVATE_KEY=

# Where the agent posts its proposals. Points at this app during development, which makes
# the hop a formality and keeps the whole flow runnable on a laptop. In production it is
# https://onlatch.com/proxy and the agent code does not change to notice.
#
# Latch runs in the cloud and cannot reach localhost, which is why it is the last thing
# wired up rather than the first.
LATCH_PROXY_URL=http://localhost:3000

# Only in production. The agent authenticating to Latch, sent as Authorization: Bearer.
# Left empty here so a local run talks straight to itself.
LATCH_API_KEY=

# Only in production, and the opposite half of LATCH_API_KEY: Latch authenticating to this
# server, attached as x-agent-gateway-secret on the way through. Never the same value.
#
# Empty means the signing routes accept a direct call, which is the development
# arrangement. Set it and they stop, in the same code and with no flag.
AGENT_GATEWAY_SECRET=

# Removed on purpose: GROQ_API_KEY, PINATA_JWT and NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID.
# Listing images go to Supabase Storage, and Pinata's only planned use was IPFS terms,
# which CLAUDE.md section 7 defers. WalletConnect went with RainbowKit in checkpoint 3,
# Privy owns the wallet list now.

# Six digit codes for /admin, the log of what the dispute arbitrator decided. Generate one
# with npm run admin:setup, which also prints the link to add it to Google Authenticator.
ADMIN_TOTP_SECRET=
