# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Anything with the NEXT_PUBLIC_ prefix is compiled into the browser bundle and is
# public. Anything without it stays on the server. Do not add the prefix to a secret.

# Privy. The app id is public, the app secret is not: the secret is what lets the server
# verify a login and read the user's wallet, instead of trusting whatever address the
# browser claims to be.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Supabase. URL and anon key are safe in the browser. The service role key bypasses row
# level security and can wipe the database, so it is server only and never logged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Which chain this build talks to. Defaults to the Hardhat node (31337).
# Set to 11155111 for Sepolia at checkpoint 12.
NEXT_PUBLIC_CHAIN_ID=

# Groq, used by the moderation and dispute agents (checkpoint 9 and 10). Server only.
GROQ_API_KEY=

# EmailJS, for notifying owners about new rental requests (checkpoint 8)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Wallet that signs agent decisions on chain. Server only, never expose to the agent.
AGENT_SIGNER_PRIVATE_KEY=

# Where the agent posts its proposals. Points at this app during development,
# swapped for the Latch proxy URL at checkpoint 11.
LATCH_PROXY_URL=http://localhost:3000

# Removed on purpose: PINATA_JWT and NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID.
# Listing images go to Supabase Storage, and Pinata's only planned use was IPFS terms,
# which CLAUDE.md section 7 defers. WalletConnect went with RainbowKit in checkpoint 3,
# Privy owns the wallet list now.
